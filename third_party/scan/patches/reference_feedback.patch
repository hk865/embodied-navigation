+void SCANReplanFSM::publishReferenceStatus(
+    const std::string &event, const std::string &reason,
+    const builtin_interfaces::msg::Time *input_stamp, const std::string &input_frame,
+    int segment_index, double segment_length) {
+    std::ostringstream out;
+    out << std::setprecision(17)
+        << "{\"schema\":\"scan_reference_status/v1\",\"event\":"
+        << r74_observation::quoted(event) << ",\"reason\":" << r74_observation::quoted(reason)
+        << ",\"run_id\":" << r74_observation::quoted(reference_run_id_)
+        << ",\"reference_epoch\":" << reference_epoch_
+        << ",\"planner_process_id\":" << getpid()
+        << ",\"frame_id\":" << r74_observation::quoted(self_inflation_frame_id_)
+        << ",\"input_frame_id\":" << r74_observation::quoted(input_frame)
+        << ",\"reference_stamp\":";
+    if (input_stamp)
+        out << '[' << input_stamp->sec << ',' << input_stamp->nanosec << ']';
+    else
+        out << "null";
+    out << ",\"have_odometry\":" << (have_odom_ ? "true" : "false")
+        << ",\"last_consumed_odometry_stamp_ns\":" << last_odom_stamp_ns_
+        << ",\"last_consumed_odometry_frame_id\":" << r74_observation::quoted(last_odom_frame_id_)
+        << ",\"segment_index\":" << segment_index << ",\"segment_length_m\":";
+    if (segment_length >= 0.0 && std::isfinite(segment_length))
+        out << segment_length;
+    else
+        out << "null";
+    out << '}';
+    std_msgs::msg::String status;
+    status.data = out.str();
+    reference_status_pub_->publish(status);
 }
 
