+void GridMap::completePendingRotationQuery() {
+    const auto pending = rotation_pending_request_;
+    if (pending) rotationQueryCallback(pending);
+}
+
+void GridMap::rotationQueryCallback(const std_msgs::msg::String::ConstSharedPtr &message) {
+    TraceJson response = {{"version",1},{"status","failed"},{"reason","invalid_request"}};
+    try {
+        // External ROS ingress; bound parsing work and reject misrouted processes.
+        if (message->data.size() > 4096) throw std::invalid_argument("request_too_large");
+        const auto request = TraceJson::parse(message->data);
+        if (!request.is_object() || request.at("version") != 1 ||
+            !request.at("seq").is_number_integer() || !request.at("query_id").is_number_integer() ||
+            !request.at("sample_id").is_number_integer() ||
+            !request.at("body_stamp_ns").is_number_integer() ||
+            !request.at("minimum_cloud_stamp_ns").is_number_integer() ||
+            !request.at("target_yaw_rad").is_number()) throw std::invalid_argument("invalid_request");
+        const std::string run = request.at("run_id").get<std::string>();
+        const int64_t seq = request.at("seq").get<int64_t>();
+        const int64_t query_id = request.at("query_id").get<int64_t>();
+        const int64_t sample_id = request.at("sample_id").get<int64_t>();
+        const std::string nonce = request.at("startup_nonce").get<std::string>();
+        const double target = request.at("target_yaw_rad").get<double>();
+        if (!std::isfinite(target) || seq < 1 || query_id < 1 || sample_id < 1) throw std::invalid_argument("invalid_request");
+        response.update({{"run_id",run},{"seq",seq},{"query_id",query_id},{"sample_id",sample_id},{"target_yaw_rad",target},
+                         {"native_identity",{{"pid",getpid()},{"startup_nonce",nonce}}}});
+        if (run != node_->get_parameter("fsm.reference_run_id").as_string() ||
+            seq != node_->get_parameter("fsm.reference_epoch").as_int() ||
+            nonce != node_->get_parameter("fsm.child_odometry_ack_nonce").as_string())
+            throw std::invalid_argument("scope_mismatch");
+        // Keep the accepted snapshot fixed until its actual inputs are consumed.
+        if (rotation_pending_request_ && rotation_pending_request_ != message) return;
+        const auto &body = input_body_pose_;
+        const int64_t body_stamp = rclcpp::Time(body.header.stamp).nanoseconds();
+        const int64_t cloud_stamp = rclcpp::Time(input_fusion_cloud_header_.stamp).nanoseconds();
+        if (!(input_has_body_ && input_has_cloud_ && input_map_revision_ > 0 &&
+            body_stamp >= request.at("body_stamp_ns").get<int64_t>() &&
+            cloud_stamp >= request.at("minimum_cloud_stamp_ns").get<int64_t>())) {
+            rotation_pending_request_ = message;
+            return;
+        }
+        rotation_pending_request_.reset();
+        {
+            const std::string frame = request.at("frame_id").get<std::string>();
+            const std::string child = request.at("child_frame_id").get<std::string>();
+            if (frame != body.header.frame_id || child != body.child_frame_id ||
+                frame != input_fusion_cloud_header_.frame_id || frame != input_fusion_sensor_pose_.header.frame_id ||
+                child != input_fusion_sensor_pose_.child_frame_id || frame != mp_.frame_id_)
+                throw std::invalid_argument("consumed_frame_mismatch");
+            const auto &p = body.pose.pose.position;
+            const auto &q = body.pose.pose.orientation;
+            const Eigen::Vector3d position(p.x,p.y,p.z);
+            const double yaw = std::atan2(2.0*(q.w*q.z+q.x*q.y),1.0-2.0*(q.y*q.y+q.z*q.z));
+            const auto result = queryRotationSpace(position,yaw,target);
+            const auto &sensor = input_fusion_sensor_pose_;
+            const auto &sp = sensor.pose.pose.position; const auto &sq = sensor.pose.pose.orientation;
+            response.update({{"status",result.occupancy == 0 ? "clear" : "blocked"},
+                {"reason",result.occupancy < 0 ? "out_of_bounds" : (result.occupancy ? "occupied" : "clear")},
+                {"body_stamp_ns",body_stamp},{"frame_id",frame},{"child_frame_id",child},
+                {"position_xyz_m",traceVector(position)},{"yaw_rad",yaw},{"occupancy",result.occupancy},
+                {"checked_arc",{{"start_yaw_rad",yaw},{"target_yaw_rad",target},
+                    {"delta_yaw_rad",result.delta_yaw},{"queries",result.queries}}},
+                {"first_blocking_yaw_rad",nullptr},{"blocking_part",nullptr},
+                {"source",{{"body_stamp_ns",body_stamp},{"body_frame_id",body.header.frame_id},
+                    {"body_child_frame_id",body.child_frame_id},{"body_quaternion_xyzw",{q.x,q.y,q.z,q.w}},
+                    {"cloud_stamp_ns",cloud_stamp},{"cloud_frame_id",input_fusion_cloud_header_.frame_id},
+                    {"sensor_pose_stamp_ns",rclcpp::Time(sensor.header.stamp).nanoseconds()},
+                    {"sensor_frame_id",sensor.header.frame_id},{"sensor_child_frame_id",sensor.child_frame_id},
+                    {"sensor_pose_xyz_m",{sp.x,sp.y,sp.z}},{"sensor_quaternion_xyzw",{sq.x,sq.y,sq.z,sq.w}},
+                    {"fusion_ray_position_xyz_m",traceVector(input_fusion_ray_pos_)},
+                    {"fusion_ray_quaternion_xyzw",traceQuaternion(input_fusion_ray_q_)},
+                    {"fusion_sim_s",input_fusion_sim_s_},{"map_revision",input_map_revision_}}}});
+            if (result.occupancy != 0) {
+                const auto &detail = result.blocking_query;
+                const bool front = detail.front_result != 0;
+                const auto &point = front ? detail.front : detail.rear;
+                Eigen::Vector3i index; posToIndex(point,index);
+                response["first_blocking_yaw_rad"] = result.first_blocking_yaw;
+                response["blocking_part"] = front ? "front" : "rear";
+                response["query"] = {{"position_xyz_m",traceVector(point)},{"global_index",traceVector(index)},
+                    {"front_result",detail.front_result},{"rear_evaluated",detail.rear_evaluated},
+                    {"rear_result",detail.rear_evaluated ? TraceJson(detail.rear_result) : TraceJson(nullptr)},
+                    {"buffer_accessed",result.occupancy >= 0},{"map_min",traceVector(mp_.map_min_boundary_)},
+                    {"map_max",traceVector(mp_.map_max_boundary_)},{"resolution",mp_.resolution_}};
+                if (result.occupancy > 0) {
+                    const int address=toAddress(index);
+                    response["query"]["address"] = address;
+                    response["query"]["raw_logodds"] = md_.occupancy_buffer_[address];
+                    response["query"]["inflate_count"] = md_.occupancy_buffer_inflate_cnt_[address];
+                }
+                traceRejectedRotation(detail,yaw,target);
+            }
+        }
+    } catch (const std::exception &error) {
+        response["status"] = "failed"; response["reason"] = error.what();
+    }
+    std_msgs::msg::String result; result.data = response.dump();
+    rotation_result_pub_->publish(result);
+}
