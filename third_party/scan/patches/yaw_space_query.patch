+    double resolution_inv, const Eigen::Vector3d &map_min, const Eigen::Vector3d &map_max,
+    double start_yaw, double target_yaw) {
+    const double delta = std::atan2(std::sin(target_yaw-start_yaw),std::cos(target_yaw-start_yaw));
+    const double end = start_yaw+delta;
+    const double low = std::min(start_yaw,end), high = std::max(start_yaw,end);
+    const double pi = std::acos(-1.0), period = 2.0*pi;
+    std::vector<double> boundaries{low,high};
+    auto add = [&](double root) {
+        const int first = static_cast<int>(std::floor((low-root)/period))-1;
+        const int last = static_cast<int>(std::ceil((high-root)/period))+1;
+        for (int k=first;k<=last;++k) {
+            const double angle = root+k*period;
+            if (angle < low || angle > high) continue;
+            boundaries.push_back(angle);
+            const double before = std::nextafter(angle,-std::numeric_limits<double>::infinity());
+            const double after = std::nextafter(angle,std::numeric_limits<double>::infinity());
+            if (before>=low) boundaries.push_back(before);
+            if (after<=high) boundaries.push_back(after);
+        }
+    };
+    // Extrema also cover tangencies; no sign-change assumption is used.
+    for (int k=0;k<4;++k) add(k*pi/2.0);
+    if (offset != 0.0) for (int sign : {-1,1}) for (int axis=0;axis<2;++axis) {
+        auto crossing = [&](double plane) {
+            const double value = (plane-position(axis))/(sign*offset);
+            if (value < -1.0 || value > 1.0) return;
+            if (axis==0) { const double a=std::acos(value); add(a);add(-a); }
+            else { const double a=std::asin(value);add(a);add(pi-a); }
+        };
+        const int first = static_cast<int>(std::floor((position(axis)-std::abs(offset))*resolution_inv))-1;
+        const int last = static_cast<int>(std::ceil((position(axis)+std::abs(offset))*resolution_inv))+1;
+        for (int k=first;k<=last;++k) crossing(k/resolution_inv);
+        crossing(map_min(axis)+1e-4);
+        crossing(map_max(axis)-1e-4);
+    }
+    std::sort(boundaries.begin(),boundaries.end());
+    boundaries.erase(std::unique(boundaries.begin(),boundaries.end()),boundaries.end());
+    std::vector<double> angles=boundaries;
+    for (size_t i=1;i<boundaries.size();++i)
+        angles.push_back(boundaries[i-1]+(boundaries[i]-boundaries[i-1])*0.5);
+    std::sort(angles.begin(),angles.end());
+    angles.erase(std::unique(angles.begin(),angles.end()),angles.end());
+    if (delta<0.0) std::reverse(angles.begin(),angles.end());
+    return angles;
+}
+
+GridMap::RotationSpaceResult GridMap::queryRotationSpace(const Eigen::Vector3d &position,
+                                                         double start_yaw, double target_yaw) {
+    RotationSpaceResult result;
+    result.delta_yaw = std::atan2(std::sin(target_yaw-start_yaw),std::cos(target_yaw-start_yaw));
+    const auto angles = rotationQueryAngles(position,mp_.double_cylinder_offset_,mp_.resolution_inv_,
+                                            mp_.map_min_boundary_,mp_.map_max_boundary_,start_yaw,target_yaw);
+    for (const double yaw : angles) {
+        VoxelQuery detail;
+        const int occupied = getInflateOccupancy(position,yaw,&detail);
+        ++result.queries;
+        if (occupied != 0) {
+            result.occupancy = occupied;
+            result.first_blocking_yaw = yaw;
+            result.blocking_query = detail;
+            break;
+        }
+    }
+    return result;
+}
