+int GridMap::stairBoxCollision(const Eigen::Vector3d &low,const Eigen::Vector3d &high) {
+    if (!low.allFinite() || !high.allFinite() || !isInMap(low) || !isInMap(high)) return -1;
+    Eigen::Vector3i first,last; posToIndex(low,first); posToIndex(high,last);
+    for (int x=first.x();x<=last.x();++x)
+        for (int y=first.y();y<=last.y();++y)
+            for (int z=first.z();z<=last.z();++z)
+                if (getOccupancy(Eigen::Vector3i(x,y,z))==1) return 1;
+    return 0;
+}
+
+int GridMap::queryStairSweep(const Eigen::Vector3d &start,const Eigen::Vector3d &end,
+                           double yaw_start,double yaw_end) {
+    refreshStairLabels();
+    if (stair_cells_.empty()) return 0;
+    const auto &b=input_body_pose_; const auto &q=b.pose.pose.orientation;
+    Eigen::Quaterniond quat(q.w,q.x,q.y,q.z);
+    const int64_t now=node_->now().nanoseconds(), stamp=rclcpp::Time(b.header.stamp).nanoseconds();
+    if (!input_has_body_ || now<stamp || now-stamp>300000000 || !quat.coeffs().allFinite() ||
+        std::abs(quat.norm()-1.)>.01 || !std::isfinite(yaw_start) || !std::isfinite(yaw_end)) return -1;
+    const Eigen::Matrix3d R=quat.normalized().toRotationMatrix();
+    const double current_yaw=std::atan2(R(1,0),R(0,0));
+    const double delta=std::atan2(std::sin(yaw_end-yaw_start),std::cos(yaw_end-yaw_start));
+    const Eigen::Matrix3d A=Eigen::AngleAxisd(yaw_start-current_yaw,Eigen::Vector3d::UnitZ()).toRotationMatrix()*R;
+    // Union of base box, front cylinder and sphere, expressed about go2_imu.
+    // 20mm additional geometric margin, NOT a certified attitude-error bound.
+    // Current roll/pitch are held fixed; this is not future posture prediction.
+    const Eigen::Vector3d center(.0557969357,0.,-.0198910447), half(.26405,.05,.082);
+    const Eigen::Vector3d extent=A.cwiseAbs()*half+Eigen::Vector3d::Constant(.02);
+    const Eigen::Vector3d offset=A*center;
+    const double rotation_pad=2.*(center.norm()+half.norm())*std::sin(std::abs(delta)/2.);
+    const Eigen::Vector3d pad=Eigen::Vector3d::Constant(rotation_pad);
+    return stairBoxCollision(start.cwiseMin(end)+offset-extent-pad,
+                             start.cwiseMax(end)+offset+extent+pad);
+}
+
+int GridMap::queryStairControlHull(const Eigen::MatrixXd &points) {
+    refreshStairLabels();
+    if (stair_cells_.empty()) return 0;
+    if (points.rows()!=3 || points.cols()==0 || !points.allFinite()) return -1;
+    const int64_t now=node_->now().nanoseconds();
+    const int64_t stamp=rclcpp::Time(input_body_pose_.header.stamp).nanoseconds();
+    if (!input_has_body_ || now<stamp || now-stamp>300000000) return -1;
+    const auto &q=input_body_pose_.pose.pose.orientation;
+    Eigen::Quaterniond quat(q.w,q.x,q.y,q.z);
+    if (!quat.coeffs().allFinite() || std::abs(quat.norm()-1.)>.01) return -1;
+    const auto R=quat.normalized().toRotationMatrix();
+    const Eigen::Vector3d center(.0557969357,0.,-.0198910447), half(.26405,.05,.082);
+    const double radius=center.norm()+half.norm()+.02;
+    const double zhalf=R.row(2).cwiseAbs().dot(half)+.02;
+    const double zcenter=(R*center).z();
+    const int width=std::min(4,static_cast<int>(points.cols()));
+    for (int i=0;i<=points.cols()-width;++i) {
+        const auto span=points.middleCols(i,width);
+        const Eigen::Vector3d low=span.rowwise().minCoeff()+Eigen::Vector3d(-radius,-radius,zcenter-zhalf);
+        const Eigen::Vector3d high=span.rowwise().maxCoeff()+Eigen::Vector3d(radius,radius,zcenter+zhalf);
+        const int collision=stairBoxCollision(low,high);
+        if (collision) return collision;
+    }
+    return 0;
+}
