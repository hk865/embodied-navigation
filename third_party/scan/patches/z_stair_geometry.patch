+// Stair semantics never change raw hit/miss occupancy. Only source inflation
+// contributions are removed; overlapping wall contributions remain counted.
+void GridMap::publishStairStatus(const std::string &status,const std::string &reason,int64_t stamp,size_t count) {
+    if (!stair_status_pub_) return;
+    TraceJson event={{"version",1},{"status",status},{"reason",reason},{"source_stamp_ns",stamp},
+        {"accepted_count",count},{"run_id",node_->get_parameter("fsm.reference_run_id").as_string()},
+        {"seq",node_->get_parameter("fsm.reference_epoch").as_int()},
+        {"localization_generation",node_->get_parameter("fsm.localization_generation").as_int()},
+        {"startup_nonce",node_->get_parameter("fsm.child_odometry_ack_nonce").as_string()}};
+    std_msgs::msg::String message; message.data=event.dump(); stair_status_pub_->publish(message);
+}
+
+void GridMap::clearStairLabels(const std::string &reason) {
+    const auto previous_stamp=stair_source_stamp_ns_;
+    auto old = std::move(stair_cells_);
+    stair_cells_.clear();
+    for (const auto &entry : old)
+        if (isInMap(entry.second) && md_.occupancy_buffer_[entry.first] > mp_.min_occupancy_log_)
+            updateInflation(entry.second,1);
+    stair_source_stamp_ns_ = 0;
+    if (!old.empty()) publishStairStatus("cleared",reason,previous_stamp,0);
+}
+
+void GridMap::stairLabelsCallback(const std_msgs::msg::String::ConstSharedPtr &message) {
+    stair_received_wall_ = std::chrono::steady_clock::now();
+    stair_pending_ = message;
+    refreshStairLabels();
+}
+
+void GridMap::refreshStairLabels() {
+    if (!stair_pending_ && stair_cells_.empty()) return;
+    if (std::chrono::steady_clock::now()-stair_received_wall_ > std::chrono::seconds(2)) {
+        clearStairLabels("expired_wall"); stair_pending_.reset(); return;
+    }
+    const int64_t now = node_->now().nanoseconds();
+    if (stair_source_stamp_ns_ && (now < stair_source_stamp_ns_ || now-stair_source_stamp_ns_ > 300000000))
+        clearStairLabels("expired_sim");
+    if (!stair_cells_.empty()) {
+        const int64_t body_stamp=rclcpp::Time(input_body_pose_.header.stamp).nanoseconds();
+        if (stair_run_!=node_->get_parameter("fsm.reference_run_id").as_string() ||
+            stair_epoch_!=node_->get_parameter("fsm.reference_epoch").as_int() ||
+            stair_generation_!=node_->get_parameter("fsm.localization_generation").as_int() ||
+            stair_nonce_!=node_->get_parameter("fsm.child_odometry_ack_nonce").as_string() ||
+            stair_child_!=input_body_pose_.child_frame_id ||
+            !input_has_body_ || !input_has_cloud_ || now<body_stamp || now-body_stamp>300000000 ||
+            input_body_pose_.header.frame_id!=mp_.frame_id_ ||
+            input_fusion_cloud_header_.frame_id!=mp_.frame_id_)
+            clearStairLabels("body_or_frame_stale");
+    }
+    if (!stair_pending_) return;
+    try {
+        if (stair_pending_->data.size()>262144) throw std::invalid_argument("stair_labels_size");
+        const auto j=TraceJson::parse(stair_pending_->data);
+        if (j.at("version")!=1 || !j.at("source_stamp_ns").is_number_integer() ||
+            !j.at("seq").is_number_integer() || !j.at("localization_generation").is_number_integer() ||
+            j.at("run_id")!=node_->get_parameter("fsm.reference_run_id").as_string() ||
+            j.at("seq")!=node_->get_parameter("fsm.reference_epoch").as_int() ||
+            j.at("localization_generation")!=node_->get_parameter("fsm.localization_generation").as_int() ||
+            j.at("startup_nonce")!=node_->get_parameter("fsm.child_odometry_ack_nonce").as_string() ||
+            j.at("frame_id")!=mp_.frame_id_ ||
+            j.at("resolution_m").get<double>()!=mp_.resolution_ ||
+            !j.at("voxel_indices").is_array() || j.at("voxel_indices").size()>4096)
+            throw std::invalid_argument("stair_labels_identity");
+        const auto stamp=j.at("source_stamp_ns").get<int64_t>();
+        if (stamp<=0 || stamp>now || now-stamp>300000000) throw std::invalid_argument("stair_labels_stamp");
+        if (!input_has_body_ || !input_has_cloud_ || input_map_revision_==0) return;
+        const auto fused=rclcpp::Time(input_fusion_cloud_header_.stamp).nanoseconds();
+        if (fused<stamp) return;
+        const auto body_stamp=rclcpp::Time(input_body_pose_.header.stamp).nanoseconds();
+        if (now<body_stamp || now-body_stamp>300000000 ||
+            j.at("frame_id")!=input_body_pose_.header.frame_id ||
+            j.at("frame_id")!=input_fusion_cloud_header_.frame_id ||
+            j.at("child_frame_id")!=input_body_pose_.child_frame_id)
+            throw std::invalid_argument("stair_labels_pose");
+        std::map<int,Eigen::Vector3i> cells;
+        for (const auto &v:j.at("voxel_indices")) {
+            if (!v.is_array() || v.size()!=3 || !v[0].is_number_integer() ||
+                !v[1].is_number_integer() || !v[2].is_number_integer()) throw std::invalid_argument("stair_labels_index");
+            Eigen::Vector3i id(v[0].get<int>(),v[1].get<int>(),v[2].get<int>());
+            if (isInMap(id) && getOccupancy(id)==1) cells.emplace(toAddress(id),id);
+        }
+        clearStairLabels();
+        for (const auto &entry:cells) updateInflation(entry.second,-1);
+        stair_cells_=std::move(cells); stair_source_stamp_ns_=stamp;
+        stair_run_=j.at("run_id").get<std::string>(); stair_nonce_=j.at("startup_nonce").get<std::string>();
+        stair_child_=j.at("child_frame_id").get<std::string>();
+        stair_epoch_=j.at("seq").get<int64_t>(); stair_generation_=j.at("localization_generation").get<int64_t>();
+        publishStairStatus("accepted","fresh_fused_labels",stamp,stair_cells_.size());
+        stair_pending_.reset();
+    } catch (const std::exception &error) {
+        // Invalid/expired externally supplied authority cannot keep an old exemption.
+        clearStairLabels("invalid_label"); stair_pending_.reset();
+        publishStairStatus("rejected",error.what(),0,0);
+    }
+}
