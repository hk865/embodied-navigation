@@ -0,0 +1,106 @@
+#include "plan_env/voxel_trace.h"
+#include <algorithm>
+#include <cmath>
+#include <fstream>
+#include <iostream>
+
+VoxelTrace::VoxelTrace(const std::string &path, int max_events, int max_bytes, double period_s) {
+    if (path.empty()) return;
+    // These are external diagnostic parameters, never planner admissibility.
+    if (max_events < 1 || max_events > 8 || max_bytes < 16384 || max_bytes > 2097152 ||
+        !std::isfinite(period_s) || period_s < 1.0) {
+        std::cerr << "[VoxelTrace] invalid diagnostic budget; tracing disabled\n";
+        return;
+    }
+    try {
+        directory_ = path;
+        if (!std::filesystem::create_directory(directory_)) {
+            std::cerr << "[VoxelTrace] output directory exists; tracing disabled\n";
+            return;
+        }
+        first_limit_ = max_events - 1;
+        first_written_.assign(first_limit_,false);
+        // Reserve a latest-file atomic replacement and a small final summary.
+        record_bytes_ = std::min<size_t>(131072, (max_bytes - 4096) / (max_events + 1));
+        period_s_ = period_s;
+        enabled_ = true;
+    } catch (const std::exception &e) {
+        std::cerr << "[VoxelTrace] setup failed: " << e.what() << "\n";
+    }
+}
+
+bool VoxelTrace::writeFile(const std::filesystem::path &path, const std::string &data) noexcept {
+    try {
+        std::ofstream stream(path, std::ios::binary | std::ios::trunc);
+        stream.write(data.data(), static_cast<std::streamsize>(data.size()));
+        stream.close();
+        if (stream) return true;
+    } catch (...) {}
+    ++errors_;
+    return false;
+}
+
+void VoxelTrace::writeLast() noexcept {
+    if (!enabled_ || latest_.empty()) return;
+    try {
+        const auto temporary = directory_ / "last_rejection.tmp";
+        if (writeFile(temporary, latest_)) {
+            std::error_code error;
+            std::filesystem::rename(temporary, directory_ / "last_rejection.json", error);
+            if (error) ++errors_;
+        }
+    } catch (...) { ++errors_; }
+    writeSummary();
+}
+
+bool VoxelTrace::shouldRecord(const std::string &key, double sim_s) noexcept {
+    if (!enabled_) return false;
+    ++seen_;
+    try {
+        const bool first = static_cast<int>(first_keys_.size()) < first_limit_ &&
+            std::find(first_keys_.begin(), first_keys_.end(), key) == first_keys_.end();
+        const bool periodic = last_sample_sim_s_ < 0.0 || sim_s - last_sample_sim_s_ >= period_s_;
+        if (first) first_keys_.push_back(key);
+        if (periodic) last_sample_sim_s_ = sim_s;
+        return first || periodic;
+    } catch (...) { ++errors_; return false; }
+}
+
+void VoxelTrace::record(const std::string &key, double sim_s, const std::string &payload) noexcept {
+    if (!enabled_) return;
+    if (payload.size() > record_bytes_) {
+        ++oversize_;
+        last_write_sim_s_ = sim_s;
+        writeSummary();
+        return;
+    }
+    try {
+        latest_ = payload;
+        const auto first = std::find(first_keys_.begin(), first_keys_.end(), key);
+        if (first != first_keys_.end()) {
+            const size_t index = static_cast<size_t>(first-first_keys_.begin());
+            if (!first_written_[index]) {
+                const auto name = "first_" + std::to_string(index) + ".json";
+                if (writeFile(directory_ / name, payload)) first_written_[index] = true;
+            }
+        }
+        if (last_write_sim_s_ < 0.0 || sim_s - last_write_sim_s_ >= period_s_) {
+            writeLast();
+            last_write_sim_s_ = sim_s;
+        }
+    } catch (...) { ++errors_; }
+}
+
+void VoxelTrace::writeSummary() noexcept {
+    try {
+        const std::string summary = "{\"seen\":" + std::to_string(seen_) +
+            ",\"retained_first\":" + std::to_string(std::count(first_written_.begin(),first_written_.end(),true)) +
+            ",\"oversize_dropped\":" + std::to_string(oversize_) +
+            ",\"write_errors\":" + std::to_string(errors_) + "}\n";
+        writeFile(directory_ / "summary.json", summary);
+    } catch (...) {}
+}
+
+VoxelTrace::~VoxelTrace() {
+    if (enabled_) { writeLast(); writeSummary(); }
+}
