+void GridMap::traceRejectedOccupancy(const VoxelQuery &query, const char *stage, double candidate_t,
+                                    double interval, const Eigen::MatrixXd &control_points,
+                                    const Eigen::Vector3d &pos_next) noexcept {
+    if (!voxel_trace_ || !voxel_trace_->enabled()) return;
+    try {
+        const double sim_s = node_->now().seconds();
+        Eigen::Vector3i front_id, rear_id;
+        posToIndex(query.front,front_id); posToIndex(query.rear,rear_id);
+        const std::string key = std::string(stage)+traceVector(front_id).dump()+
+            traceVector(rear_id).dump()+std::to_string(query.front_result)+
+            (query.rear_evaluated ? std::to_string(query.rear_result) : "not_evaluated");
+        if (!voxel_trace_->shouldRecord(key,sim_s)) return;
+        auto cell = [this](const Eigen::Vector3i &id) -> TraceJson {
+            TraceJson c = {{"index", traceVector(id)}, {"in_bounds", isInMap(id)}};
+            Eigen::Vector3d center; indexToPos(id, center); c["center"] = traceVector(center);
+            if (isInMap(id)) {
+                const int address = toAddress(id);
+                c["local_index"] = {getLocalIndex(id(0),0),getLocalIndex(id(1),1),getLocalIndex(id(2),2)};
+                c["address"] = address;
+                c["raw_logodds"] = md_.occupancy_buffer_[address];
+                c["raw_occupied"] = md_.occupancy_buffer_[address] > mp_.min_occupancy_log_;
+                c["inflate"] = static_cast<int>(md_.occupancy_buffer_inflate_[address]);
+                c["inflate_count"] = md_.occupancy_buffer_inflate_cnt_[address];
+            }
+            return c;
+        };
+        auto probe = [&](const Eigen::Vector3d &p, bool evaluated, int result) -> TraceJson {
+            TraceJson q = {{"position", traceVector(p)}, {"evaluated", evaluated}};
+            if (!evaluated) return q;
+            q["result"] = result;
+            q["reason"] = result < 0 ? "out_of_bounds" : (result ? "occupied" : "free");
+            Eigen::Vector3i id; posToIndex(p, id);
+            q["cell"] = {{"index",traceVector(id)},{"in_bounds",isInMap(id)}};
+            q["buffer_accessed"] = result >= 0;
+            if (result < 0) return q;
+            q["cell"] = cell(id);
+            q["local_cells"] = TraceJson::array();
+            for (int x=-1;x<=1;++x) for(int y=-1;y<=1;++y) for(int z=-1;z<=1;++z)
+                q["local_cells"].push_back(cell(id+Eigen::Vector3i(x,y,z)));
+            q["inverse_inflation_cells"] = TraceJson::array();
+            size_t count = 0;
+            for (const auto &offset : md_.inflate_offsets_) {
+                if (count++ == 512) break;
+                TraceJson source = cell(id-offset);
+                source["offset"] = traceVector(offset);
+                q["inverse_inflation_cells"].push_back(std::move(source));
+            }
+            q["inverse_inflation_complete"] = md_.inflate_offsets_.size() <= 512;
+            q["inverse_inflation_total"] = md_.inflate_offsets_.size();
+            return q;
+        };
+        TraceJson event = {{"schema", "scan_voxel_rejection"}, {"stage", stage},
+            {"sim_s", sim_s}, {"pid", getpid()}, {"map_revision", trace_map_revision_},
+            {"monotonic_ns", std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count()},
+            {"candidate", {{"t",candidate_t},{"interval",interval},{"position",traceVector(query.position)},
+                {"pos_next",traceVector(pos_next)},{"yaw",query.yaw},{"yaw_source","path_segment"}}},
+            {"front",probe(query.front,true,query.front_result)},
+            {"rear",probe(query.rear,query.rear_evaluated,query.rear_result)},
+            {"returned", query.front_result != 0 ? query.front_result : query.rear_result}};
+        event["candidate"]["first_control_points"] = TraceJson::array();
+        for (int i=0;i<std::min<int>(6,control_points.cols());++i)
+            event["candidate"]["first_control_points"].push_back(traceVector(control_points.col(i)));
+        event["map"] = {{"frame_id",mp_.frame_id_},{"resolution",mp_.resolution_},
+            {"origin",traceVector(mp_.map_origin_)},{"origin_index",traceVector(mp_.map_origin_idx_)},
+            {"shape",traceVector(mp_.map_voxel_num_)},{"min_index",traceVector(mp_.map_bound_min_idx_)},
+            {"max_index",traceVector(mp_.map_bound_max_idx_)},{"min_world",traceVector(mp_.map_min_boundary_)},
+            {"max_world",traceVector(mp_.map_max_boundary_)},{"world_bound_epsilon",1e-4},
+            {"occupancy_threshold",mp_.min_occupancy_log_},{"cylinder_offset",mp_.double_cylinder_offset_},
+            {"cylinder_radius",mp_.double_cylinder_radius_},{"inflation_z_up",mp_.obstacles_inflation_z_up},
+            {"inflation_z_down",mp_.obstacles_inflation_z_down},{"cloud_is_world",mp_.cloud_is_world_},
+            {"need_extrinsic",mp_.need_extrinsic_}};
+        event["sources"] = {{"body_pose_subscription",traceOdometry(trace_body_pose_)},
+            {"has_body_pose",trace_has_body_},{"has_sensor_pose",trace_has_sensor_},{"has_cloud",trace_has_cloud_},
+            {"latest_sensor_pose",traceOdometry(trace_sensor_pose_)},
+            {"fusion_sensor_pose",traceOdometry(trace_fusion_sensor_pose_)},
+            {"fusion_cloud_header",traceHeader(trace_fusion_cloud_header_)},
+            {"fusion_ray_position",traceVector(trace_fusion_ray_pos_)},
+            {"fusion_ray_quaternion_xyzw",traceQuaternion(trace_fusion_ray_q_)},
+            {"cloud_projection_sensor_pose",traceOdometry(trace_fused_cloud_sensor_pose_)},
+            {"cloud_projection_ray_position",traceVector(trace_fused_cloud_ray_pos_)},
+            {"cloud_projection_ray_quaternion_xyzw",traceQuaternion(trace_fused_cloud_ray_q_)},
+            {"fusion_sim_s",trace_fusion_sim_s_},
+            {"raw_cell_lineage","current_buffer_only; source stamps describe latest fusion, not per-cell history"}};
+        for (const char *name : {"fsm.reference_run_id", "fsm.reference_epoch"})
+            if (node_->has_parameter(name)) event["identity"][name] = node_->get_parameter(name).value_to_string();
+        voxel_trace_->record(key,sim_s,event.dump()+"\n");
+    } catch (const std::exception &e) {
+        RCLCPP_WARN_THROTTLE(node_->get_logger(), *node_->get_clock(), 10000,
+                            "[VoxelTrace] snapshot failed: %s", e.what());
+    }
+}
