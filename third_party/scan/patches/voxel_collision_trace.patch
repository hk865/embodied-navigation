+namespace {
+using TraceJson = nlohmann::json;
+template <typename Derived> TraceJson traceVector(const Eigen::MatrixBase<Derived> &v) {
+    return TraceJson::array({v(0), v(1), v(2)});
+}
+TraceJson traceQuaternion(const Eigen::Quaterniond &q) {
+    return TraceJson::array({q.x(), q.y(), q.z(), q.w()});
+}
+TraceJson traceHeader(const std_msgs::msg::Header &h) {
+    return {{"frame_id", h.frame_id}, {"stamp_sec", h.stamp.sec}, {"stamp_nanosec", h.stamp.nanosec}};
+}
+TraceJson traceOdometry(const nav_msgs::msg::Odometry &o) {
+    const auto &p = o.pose.pose; const auto &t = o.twist.twist;
+    return {{"header", traceHeader(o.header)}, {"child_frame_id", o.child_frame_id},
+            {"position", {p.position.x,p.position.y,p.position.z}},
+            {"quaternion_xyzw", {p.orientation.x,p.orientation.y,p.orientation.z,p.orientation.w}},
+            {"linear_velocity", {t.linear.x,t.linear.y,t.linear.z}},
+            {"angular_velocity", {t.angular.x,t.angular.y,t.angular.z}}};
+}
+}
