# Allowlist-only build context for the CPU image: everything is excluded first,
# then only the sources/configuration needed by the CPU test stage are re-included.
**
!src/
!src/**
!tests/
!tests/unit/
!tests/unit/**
!configs/
!configs/**
!third_party/
!third_party/scan/
!third_party/scan/plan_manage/
!third_party/scan/plan_manage/config/
!third_party/scan/plan_manage/config/planner.yaml
!pyproject.toml
**/__pycache__
**/*.pyc
