<?xml version="1.0" encoding="UTF-8"?>
<!-- 单次运行的隔离本地 DDS 图：仅回环 UDPv4 + 共享内存，禁用内置传输。
     子进程通过 FASTRTPS_DEFAULT_PROFILES_FILE 应用本 profile，使不同 run
     之间互相不可见。
     数值说明：UDP maxMessageSize=65500 字节、初始 peer 范围 32；SHM 段
     67108864 字节（64 MiB）、port_queue_capacity=512、健康检查 1000 ms；
     interfaceWhiteList 只允许 127.0.0.1。缓冲大小 0 表示不在本 profile 指定，
     具体回退语义由 Fast DDS 实现决定，仓库文档未展开。 -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>audit_udp_loopback</transport_id><type>UDPv4</type>
        <sendBufferSize>0</sendBufferSize><receiveBufferSize>0</receiveBufferSize>
        <maxMessageSize>65500</maxMessageSize><maxInitialPeersRange>32</maxInitialPeersRange>
        <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>audit_shm</transport_id><type>SHM</type>
        <maxMessageSize>65500</maxMessageSize><segment_size>67108864</segment_size>
        <port_queue_capacity>512</port_queue_capacity><healthy_check_timeout_ms>1000</healthy_check_timeout_ms>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="audit_local_transports" is_default_profile="true">
      <rtps>
        <builtin>
          <metatrafficUnicastLocatorList><locator><udpv4><address>127.0.0.1</address><port>0</port></udpv4></locator></metatrafficUnicastLocatorList>
          <initialPeersList><locator><udpv4><address>127.0.0.1</address><port>0</port></udpv4></locator></initialPeersList>
        </builtin>
        <userTransports><transport_id>audit_udp_loopback</transport_id><transport_id>audit_shm</transport_id></userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
